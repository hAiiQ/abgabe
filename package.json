{
  "name": "abgabenkonto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mitgliederportal für wöchentliche Abgaben",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check server/app.js && node --check server/storage.js && node --check public/app.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
